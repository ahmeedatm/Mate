  "narrative": {
    "northStar": "Le Cadran déplié",
    "overview": "La page locale est la tablette vue depuis l'ordinateur : mêmes tokens jour et nuit, même police, même geste de sélection (un trait rouge qui glisse). Elle ne ressemble pas à une page d'admin faite de cartes centrées. Une barre de gauche teintée porte l'identité, l'état et les sections ; à droite, des listes groupées sur fond de tuile.\n\nLe ton est calme, dense sans être serré, lisible de loin. Le rouge « maintenant » est rare : il marque ce qui demande une action et ce qui est sélectionné. Le jour ou la nuit suit le mode de l'ordinateur ; le visualiseur est toujours en nuit.",
    "keyCharacteristics": [
      "Deux palettes Cadran (jour, nuit) portées par des variables CSS.",
      "Outfit 300 / 400 / 500, servie par le compagnon (hors ligne).",
      "Aucun ombrage structurel : la profondeur vient du ton (fond, tuile, tuile haute).",
      "Pilules, interrupteurs et curseurs habillés, aucun contrôle natif brut.",
      "Signature : la tablette dessinée à l'échelle 16:10, qui reflète thème et luminosité en direct."
    ],
    "rules": [
      {
        "name": "The Rouge Rare Rule",
        "body": "Le rouge `now` ne marque que l'état qui demande une action et la sélection. Jamais de décor, jamais en fond large (sauf `now-soft` pour l'autorisation manquante).",
        "section": "colors"
      },
      {
        "name": "The Token Pair Rule",
        "body": "Toute couleur vient d'une variable qui existe en jour et en nuit. Pas de hex en dur dans une section de la page.",
        "section": "colors"
      },
      {
        "name": "The Weight Not Family Rule",
        "body": "On distingue par le poids d'Outfit, pas en ajoutant une police. Chiffres alignés par `tnum`.",
        "section": "typography"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Une surface se distingue par son ton, pas par une ombre portée. Pas d'ombre dure décalée.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do passer chaque couleur par une variable jour / nuit de `web-style.ts`.",
      "Do réserver le rouge `now` à l'action requise et à la sélection.",
      "Do donner aux contrôles 40px de haut au moins et un focus visible de 2px `now`.",
      "Do couper les transitions sous `prefers-reduced-motion`.",
      "Do tester jour, nuit et mobile (820px) pour toute nouvelle section."
    ],
    "donts": [
      "Don't empiler des cartes centrées comme une page d'admin : listes groupées sur `tile` dans la barre + contenu.",
      "Don't introduire une seconde police ni un poids hors 300 / 400 / 500.",
      "Don't utiliser de contrôle natif non habillé (case, curseur, champ).",
      "Don't teinter de larges aplats en rouge."
    ]
  }
