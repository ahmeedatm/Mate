{
  "name": "unowhy-companion-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "mcp": "tsx src/mcp.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run format:check && npm run typecheck",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "coverage": "c8 node --import tsx --test \"test/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "service:install": "tsx --env-file-if-exists=.env scripts/service.ts install",
    "service:uninstall": "tsx --env-file-if-exists=.env scripts/service.ts uninstall",
    "service:start": "tsx --env-file-if-exists=.env scripts/service.ts start",
    "service:stop": "tsx --env-file-if-exists=.env scripts/service.ts stop",
    "service:status": "tsx --env-file-if-exists=.env scripts/service.ts status",
    "package": "tsx scripts/package.ts",
    "build:helper": "tsx scripts/build-helper.ts",
    "build:nowplaying": "clang -dynamiclib -arch arm64 -arch x86_64 -mmacosx-version-min=11.0 -fobjc-arc -framework AppKit -o src/mac/NowPlaying.dylib src/mac/nowplaying/NowPlaying.m",
    "updates:add": "tsx scripts/updates.ts add"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fastify": "^5.12.7",
    "node-ical": "^0.27.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22",
    "c8": "12.0.0",
    "esbuild": "^0.28.2",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
