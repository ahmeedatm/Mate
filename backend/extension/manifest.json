{
  "manifest_version": 3,
  "name": "Mate",
  "version": "1.2.1",
  "description": "Montre sur la tablette les onglets ouverts dans ce navigateur (Page de l'ordi) et pilote la vidéo ou la musique (page Média). Rien ne quitte l'ordinateur.",
  "permissions": ["tabs", "alarms", "storage", "scripting"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "*://*.youtube.com/*",
    "*://*.spotify.com/*",
    "*://*.deezer.com/*",
    "*://*.soundcloud.com/*",
    "*://*.twitch.tv/*",
    "*://*.dailymotion.com/*",
    "*://*.vimeo.com/*",
    "*://*.netflix.com/*",
    "*://*.primevideo.com/*",
    "*://*.disneyplus.com/*",
    "*://*.crunchyroll.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.spotify.com/*",
        "*://*.deezer.com/*",
        "*://*.soundcloud.com/*",
        "*://*.twitch.tv/*",
        "*://*.dailymotion.com/*",
        "*://*.vimeo.com/*",
        "*://*.netflix.com/*",
        "*://*.primevideo.com/*",
        "*://*.disneyplus.com/*",
        "*://*.crunchyroll.com/*"
      ],
      "js": ["media-session.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
