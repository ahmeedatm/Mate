          "glyph": "✋",
          "when": "call",
          "action": { "type": "keys", "keys": "cmd+shift+k", "app": "Microsoft Teams" }
        },
        {
          "label": "Quitter l'appel",
          "symbol": "call_end",
          "glyph": "📴",
          "color": "#C62828",
          "when": "call",
          "action": { "type": "press", "app": "Microsoft Teams", "names": ["Quitter", "Raccrocher", "Leave", "Hang up"] }
        }
      ]
    },
