        {
          "label": "Partager l'écran",
          "symbol": "present",
          "glyph": "🖥",
          "when": "share",
          "action": { "type": "press", "app": "Microsoft Teams", "names": ["Partager", "Share"] }
        },
        {
          "label": "Arrêter le partage",
          "symbol": "present",
          "glyph": "🛑",
          "when": "streaming",
          "action": {
            "type": "press",
            "app": "Microsoft Teams",
            "names": ["Arrêter le partage", "Arrêter la présentation", "Stop sharing", "Stop presenting"]
          }
        },
        {
          "label": "Lever la main",
