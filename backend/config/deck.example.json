      "app": "Microsoft Teams",
      "tiles": [
        {
          "label": "Rejoindre maintenant",
          "symbol": "call",
          "glyph": "✅",
          "when": "lobby",
          "action": { "type": "press", "app": "Microsoft Teams", "names": ["Rejoindre maintenant", "Join now"] }
        },
        {
          "label": "Micro",
          "symbol": "mic_off",
          "glyph": "🎤",
          "when": "call",
          "lit": "muted",
          "action": {
            "type": "press",
            "app": "Microsoft Teams",
            "names": ["Couper le micro", "Activer le micro", "Réactiver le micro", "Mute", "Unmute"]
          }
        },
        {
          "label": "Caméra",
