<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Pilote Windows du compagnon (voir Program.cs) : un exe compilé d'avance, sans PowerShell ni compilation à
    l'exécution (les antivirus s'en méfient). .NET Framework 4.8, présent sur
    tout Windows 10/11. Compilé depuis le Mac ou Windows : npm run build:helper (dans backend/).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>UnowhyHelper</AssemblyName>
    <RootNamespace>Companion</RootNamespace>
    <Product>Compagnon Unowhy</Product>
    <Company>Unowhy</Company>
    <Description>Pilote Windows du Compagnon Unowhy</Description>
    <Copyright>Unowhy</Copyright>
    <Version>1.0.0</Version>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <!-- Les dépendances WinRT sont des métadonnées (winmd) fournies par Windows : rien à copier à côté de l'exe. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../native.cs" Link="native.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <!-- API WinRT (lecture en cours) pour le .NET Framework : métadonnées seulement. -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
  </ItemGroup>
</Project>
