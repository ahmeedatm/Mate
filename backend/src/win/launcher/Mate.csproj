<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Mate sous Windows, un exe sans installation (voir Program.cs), sans fenêtre, sans PowerShell. .NET Framework 4.8. Compilé avec le pilote : npm run build:helper (dans backend/).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Mate</AssemblyName>
    <RootNamespace>Mate</RootNamespace>
    <Product>Mate</Product>
    <Company>Mate</Company>
    <Description>Mate</Description>
    <Copyright>Mate</Copyright>
    <Version>1.0.0</Version>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>../../../assets/compagnon.ico</ApplicationIcon>
    <ApplicationManifest>../helper/app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
    <!-- Pas de SHA du commit dans la version : l'exe ne dépend que des sources (comparé par le job windows). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
