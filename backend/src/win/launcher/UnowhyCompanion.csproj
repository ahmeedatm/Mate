<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Lanceur du compagnon sous Windows (voir Program.cs), sans fenêtre, sans PowerShell. .NET Framework 4.8. Compilé avec le pilote : npm run build:helper (dans backend/).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>UnowhyCompanion</AssemblyName>
    <RootNamespace>Companion</RootNamespace>
    <Product>Compagnon Unowhy</Product>
    <Company>Unowhy</Company>
    <Description>Compagnon Unowhy</Description>
    <Copyright>Unowhy</Copyright>
    <Version>1.0.0</Version>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>../../../assets/compagnon.ico</ApplicationIcon>
    <ApplicationManifest>../helper/app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
