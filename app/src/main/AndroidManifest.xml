<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- CAMERA : mode Caméra (Camera2 : montrer une feuille, envoyer une photo). Accordée d'office en kiosque. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- WiFi réglé depuis Réglages (kiosque : Paramètres inaccessible). Ajouter un réseau n'est permis qu'au
         device owner sur Android 10 ; la localisation est exigée par Android pour lister les réseaux autour. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Bluetooth allumé depuis Réglages > Mode kiosque (device/Bluetooth) : Paramètres est inaccessible en kiosque. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Mises à jour installées par UnoMate (device owner : sans confirmation) : moteur web, UnoMate. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Désinstaller l'essai d'une MR au pipeline plus ancien (Updater.uninstall) : sans confirmation en device owner. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- TalkBack et son raccourci malgré le kiosque (device/Accessibility) : accordée par adb à l'installation
         du kiosque (docs/kiosque.md), jamais demandée à l'utilisateur. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Ordinateurs appairés lus par l'appli d'essai dans la stable (trial/ComputersProvider) : seulement entre applis
         signées par la même clé. Nom fixe, déclaré à l'identique par la stable et l'essai. -->
    <permission
        android:name="com.unowhy.companion.permission.COMPUTERS"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.unowhy.companion.permission.COMPUTERS" />

    <queries>
        <!-- Android 11+ : sans cette déclaration, TextToSpeech ne voit aucun moteur de synthèse vocale. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Android 11+ : idem pour la reconnaissance vocale (commandes vocales). -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Android 11+ : accueils du système, masqués en kiosque (Kiosk.hideLaunchers). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Android 11+ : la stable et l'essai se voient (Réglages > Mises à jour, ordinateurs appairés). -->
        <package android:name="com.unowhy.companion" />
        <package android:name="com.unowhy.companion.essai" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="${appLabel}"
        android:icon="@drawable/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Companion">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard"
            android:windowSoftInputMode="adjustNothing|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Écran d'accueil (launcher) : désactivé par défaut pour ne pas gêner pendant le dev,
             activé par le mode kiosque (voir kiosk/Kiosk.kt). Nom complet d'avant le renommage UnoMate : c'est lui que
             les tablettes en kiosque ont retenu comme accueil. -->
        <activity-alias
            android:name="com.unowhy.companion.HomeAlias"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Nom complet d'avant le renommage UnoMate : le device owner des tablettes est ce composant, il ne doit pas changer. -->
        <receiver
            android:name="com.unowhy.companion.kiosk.KioskAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Ordinateurs appairés, pour l'essai installé à côté : permission signature, jamais d'autre appli. -->
        <provider
            android:name=".trial.ComputersProvider"
            android:authorities="${applicationId}.computers"
            android:exported="true"
            android:permission="com.unowhy.companion.permission.COMPUTERS" />

        <!-- Relance l'appli (et le kiosque) juste après sa mise à jour. -->
        <receiver
            android:name=".kiosk.UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
