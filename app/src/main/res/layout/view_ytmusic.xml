<?xml version="1.0" encoding="utf-8"?>
<!-- YouTube Music de l'ordinateur (YtMusicView) : lecteur à gauche, file d'attente à droite (cachée en taille L),
     ou l'état vide à la place des deux. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/yt_player"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <app.mate.ui.TitleView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_ytmusic" />

        <!-- Pochette et textes ; j'aime et je n'aime pas au bout de la ligne, près du titre qu'ils notent. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/yt_cover"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/thumb_bg"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/yt_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="?attr/c_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/yt_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/c_text_dim"
                    android:textSize="15sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/yt_dislike"
                style="@style/IconButton.Flat"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/ytmusic_dislike"
                android:src="@drawable/ic_thumb_down" />

            <ImageButton
                android:id="@+id/yt_like"
                style="@style/IconButton.Flat"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/ytmusic_like"
                android:src="@drawable/ic_thumb_up" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/yt_timeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/yt_progress"
                style="@style/Slider"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:paddingStart="0dp"
                android:contentDescription="@string/ytmusic_position" />

            <TextView
                android:id="@+id/yt_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="?attr/c_text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/yt_shuffle"
                style="@style/IconButton"
                android:contentDescription="@string/ytmusic_shuffle"
                android:src="@drawable/ic_shuffle" />

            <ImageButton
                android:id="@+id/yt_previous"
                style="@style/IconButton"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/media_previous"
                android:src="@drawable/ic_skip_previous" />

            <ImageButton
                android:id="@+id/yt_play"
                style="@style/IconButton.Primary"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/media_play_pause"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/yt_next"
                style="@style/IconButton"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/media_next"
                android:src="@drawable/ic_skip" />

            <ImageButton
                android:id="@+id/yt_repeat"
                style="@style/IconButton"
                android:layout_marginStart="12dp"
                android:background="@drawable/round_toggle_bg"
                android:contentDescription="@string/ytmusic_repeat_none"
                android:src="@drawable/ic_repeat" />
        </LinearLayout>
    </LinearLayout>

    <!-- File d'attente : toucher un titre le joue sur l'ordinateur ; celui en cours porte l'icône et le gras. -->
    <LinearLayout
        android:id="@+id/yt_queue_column"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <app.mate.ui.TitleView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ytmusic_queue" />

        <ScrollView
            android:id="@+id/yt_queue_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/yt_queue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/yt_queue_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ytmusic_queue_empty"
            android:textColor="?attr/c_text_dim"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Rien à piloter : pourquoi, et l'action qui en sort (connecter YTMDesktop, réessayer). -->
    <LinearLayout
        android:id="@+id/yt_empty"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_queue_music"
            android:tint="?attr/c_text_dim" />

        <TextView
            android:id="@+id/yt_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/ytmusic_empty"
            android:textColor="?attr/c_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/yt_empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxWidth="420dp"
            android:textColor="?attr/c_text_dim"
            android:textSize="14sp" />

        <Button
            android:id="@+id/yt_empty_action"
            style="@style/ActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
    </LinearLayout>
</merge>
