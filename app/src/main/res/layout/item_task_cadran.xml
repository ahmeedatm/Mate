<?xml version="1.0" encoding="utf-8"?>
<!-- Une tâche de la carte Tâches en thème Cadran : case ronde, libellé, détail éventuel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.unowhy.companion.ui.TaskCheck
        android:id="@+id/task_check"
        android:layout_width="36dp"
        android:layout_height="44dp" />

    <com.unowhy.companion.ui.StrikeText
        android:id="@+id/task_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/task_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:singleLine="true"
        android:textColor="?attr/c_text_faint"
        android:textSize="13sp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/task_open"
        style="@style/IconButton.Flat"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:contentDescription="@string/open_on_computer"
        android:src="@drawable/ic_open"
        android:visibility="gone"
        app:tint="?attr/c_text_dim" />
</LinearLayout>
