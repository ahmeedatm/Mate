<?xml version="1.0" encoding="utf-8"?>
<!-- Un ordinateur enregistré dans les Réglages : toucher = le piloter ; renommer, oublier. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/row_bg"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="4dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/computer_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_display"
        app:tint="?attr/c_text_dim" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/computer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/computer_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/c_text_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/computer_rename"
        style="@style/IconButton.Flat"
        android:contentDescription="@string/computer_rename"
        android:src="@drawable/ic_edit" />

    <ImageButton
        android:id="@+id/computer_delete"
        style="@style/IconButton.Flat"
        android:contentDescription="@string/computer_forget"
        android:src="@drawable/ic_delete" />
</LinearLayout>
