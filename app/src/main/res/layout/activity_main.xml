<?xml version="1.0" encoding="utf-8"?>
<!-- Barre de modes à gauche (tablette en paysage), écran du mode au centre,
     panneau document à droite (masqué tant qu'aucun document n'est ouvert),
     bandeau de message de l'ordinateur par-dessus. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/rail"
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:background="?attr/c_rail"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <!-- Boutons de mode, ajoutés par MainActivity. -->
        <LinearLayout
            android:id="@+id/mode_bar"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <!-- Heure, WiFi, batterie de la tablette (barre d'état masquée en kiosque) ; toucher : Réglages. -->
        <com.unowhy.companion.ui.TabletStatusView
            android:id="@+id/tablet_status"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/rail_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- Ordinateur piloté et pastille de connexion ; toucher : changer d'ordinateur. -->
        <LinearLayout
            android:id="@+id/status"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:background="@drawable/rail_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_link"
                app:tint="?attr/c_text_faint" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/status_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="70dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="?attr/c_text_faint"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- État écrit (« hors ligne »…) : la pastille ne le dit pas par sa seule couleur. -->
            <TextView
                android:id="@+id/status_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="?attr/c_text_faint"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Écran du mode ; par-dessus, « Aucun ordinateur connecté » pour les modes qui en ont besoin. -->
    <FrameLayout
        android:id="@+id/mode_area"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- paddingStart : place de la cloche des notifications, en haut à gauche de chaque écran. -->
        <FrameLayout
            android:id="@+id/mode_container"
            android:paddingStart="40dp"
            android:defaultFocusHighlightEnabled="false"
            tools:targetApi="o"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/no_computer"
            layout="@layout/view_connect"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Cloche : notifications de l'ordinateur (Depuis l'ordi > Notifications) ; pastille : arrivées depuis la
             dernière ouverture. Alignée sur la ligne de titre des écrans (padding 24 dp, hauteur 48 dp). -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="24dp">

            <ImageButton
                android:id="@+id/notif_bell"
                style="@style/IconButton.Flat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/notif_open"
                android:src="@drawable/ic_notifications" />

            <View
                android:id="@+id/notif_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/dot"
                android:backgroundTint="?attr/c_accent"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Voyant du mot de réveil « Mate », sous la cloche, dans la marge des écrans (voice/WakeWord) : atténué =
             écoute le mot, accent = « Mate » entendu ou commande en cours, absent = coupé ou en pause. -->
        <ImageView
            android:id="@+id/wake_mic"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="22dp"
            android:layout_marginTop="76dp"
            android:contentDescription="@string/wake_listening"
            android:src="@drawable/ic_mic"
            android:visibility="gone"
            app:tint="?attr/c_text_faint" />
    </FrameLayout>

    <com.unowhy.companion.ui.DocumentPanel
        android:id="@+id/document_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:visibility="gone" />
</LinearLayout>

    <!-- Thèmes Cadran : menu caché (poignée au bord gauche, voile, panneau), géré par MenuPanel. Autres thèmes : absent. -->
    <FrameLayout
        android:id="@+id/menu_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Départ du glisser : les 16 premiers dp du bord, sur toute la hauteur. -->
        <View
            android:id="@+id/menu_edge"
            android:layout_width="16dp"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <!-- Cible du toucher : 48 x 96 dp centrée sur la poignée ; hors d'elle, les touchers passent à l'écran dessous. -->
        <FrameLayout
            android:id="@+id/menu_handle"
            android:layout_width="48dp"
            android:layout_height="96dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="@string/menu_open">

            <View
                android:layout_width="5dp"
                android:layout_height="56dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="7dp"
                android:background="@drawable/menu_handle_bg" />
        </FrameLayout>

        <View
            android:id="@+id/menu_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="?attr/c_scrim"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <include
            layout="@layout/view_menu_panel"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:layout_margin="12dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Premier lancement : tant qu'aucun ordinateur n'est appairé. -->
    <com.unowhy.companion.ui.WelcomeView
        android:id="@+id/welcome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Plugins de l'ordinateur actif : première utilisation, appli compatible apparue, ou Réglages. -->
    <com.unowhy.companion.ui.PluginsView
        android:id="@+id/plugins"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/remote_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="120dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/banner_bg"
        android:drawableStart="@drawable/ic_chat"
        android:drawablePadding="16dp"
        android:drawableTint="?attr/c_accent"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="28dp"
        android:paddingBottom="20dp"
        android:textColor="?attr/c_text"
        android:textSize="24sp"
        android:visibility="gone" />
</FrameLayout>
