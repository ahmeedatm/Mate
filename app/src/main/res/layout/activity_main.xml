<?xml version="1.0" encoding="utf-8"?>
<!-- Barre fixe à gauche (Parler, profils, outils ; tablette en paysage), écran du mode au centre,
     panneau document à droite (masqué tant qu'aucun document n'est ouvert),
     bandeau de message de l'ordinateur par-dessus. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/rail"
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:background="?attr/c_rail"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <!-- Parler (ajouté en tête par ProfileRail), puis les entrées (profils, « Plus », outils) ; la pastille de
             l'élément choisi glisse derrière elles. -->
        <FrameLayout
            android:id="@+id/rail_items"
            android:layout_width="80dp"
            android:layout_height="0dp"
            android:layout_weight="1">

            <View
                android:id="@+id/rail_indicator"
                android:layout_width="4dp"
                android:layout_height="36dp"
                android:alpha="0"
                android:background="@drawable/rail_indicator_bg"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/mode_bar"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </FrameLayout>

        <!-- Cloche : notifications de l'ordinateur (Depuis l'ordi > Notifications) ; pastille : arrivées depuis la
             dernière ouverture. -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageButton
                android:id="@+id/notif_bell"
                style="@style/IconButton.Flat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/notif_open"
                android:src="@drawable/ic_notifications" />

            <View
                android:id="@+id/notif_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/dot"
                android:backgroundTint="?attr/c_accent"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Ordinateur piloté et pastille de connexion ; toucher : changer d'ordinateur. -->
        <LinearLayout
            android:id="@+id/status"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:background="@drawable/rail_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_link"
                app:tint="?attr/c_text_faint" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/status_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="70dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="?attr/c_text_faint"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <!-- Réglages : la roue, choisie (pastille grise) quand Réglages est affiché. -->
        <ImageButton
            android:id="@+id/rail_settings"
            style="@style/IconButton.Flat"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/mode_settings"
            android:src="@drawable/ic_settings"
            app:tint="@color/rail_profile_content" />
    </LinearLayout>

    <!-- Écran du mode ; par-dessus, « Aucun ordinateur connecté » pour les modes qui en ont besoin. -->
    <FrameLayout
        android:id="@+id/mode_area"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/mode_container"
            android:defaultFocusHighlightEnabled="false"
            tools:targetApi="o"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/no_computer"
            layout="@layout/view_connect"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Heure, WiFi, batterie de la tablette (barre d'état masquée en kiosque), sur une ligne en haut à droite. -->
        <com.unowhy.companion.ui.TabletStatusView
            android:id="@+id/tablet_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="24dp" />

    </FrameLayout>

    <com.unowhy.companion.ui.DocumentPanel
        android:id="@+id/document_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:visibility="gone" />
</LinearLayout>

    <!-- Premier lancement : tant qu'aucun ordinateur n'est appairé. -->
    <com.unowhy.companion.ui.WelcomeView
        android:id="@+id/welcome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/remote_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="120dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/banner_bg"
        android:drawableStart="@drawable/ic_chat"
        android:drawablePadding="16dp"
        android:drawableTint="?attr/c_accent"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="28dp"
        android:paddingBottom="20dp"
        android:textColor="?attr/c_text"
        android:textSize="24sp"
        android:visibility="gone" />
</FrameLayout>
