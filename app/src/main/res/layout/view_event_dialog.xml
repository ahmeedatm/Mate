<?xml version="1.0" encoding="utf-8"?>
<!-- Nouvel événement de l'agenda personnel (EventDialog) : quoi, quel jour, quelle heure, rappel. Défilable (clavier). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <include
        android:id="@+id/event_dialog_title"
        layout="@layout/item_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.unowhy.unomate.ui.TitleView
        style="@style/CardTitle"
        android:layout_marginTop="20dp"
        android:drawableStart="@drawable/ic_event"
        android:text="@string/event_day" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/event_dialog_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <com.unowhy.unomate.ui.TitleView
        style="@style/CardTitle"
        android:layout_marginTop="20dp"
        android:drawableStart="@drawable/ic_timer"
        android:text="@string/event_time" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/event_dialog_all_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/event_all_day"
            android:textSize="16sp" />

        <Button
            android:id="@+id/event_dialog_time"
            style="@style/ActionButton"
            android:layout_marginStart="12dp"
            android:textSize="20sp" />
    </LinearLayout>

    <com.unowhy.unomate.ui.TitleView
        android:id="@+id/event_dialog_reminder_title"
        style="@style/CardTitle"
        android:layout_marginTop="20dp"
        android:drawableStart="@drawable/ic_alarm"
        android:text="@string/event_reminder" />

    <LinearLayout
        android:id="@+id/event_dialog_reminders"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal" />
</LinearLayout>
</ScrollView>
