<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Focus en vertical (FocusWidget, taille V, DA Cadran) : titre, cadran de 176 au centre, pause et ambiance en
     bas. Mêmes identifiants que widget_focus.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_focus"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/c_home_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="?attr/c_font_title"
        android:text="@string/widget_focus"
        android:textColor="?attr/c_text_dim"
        android:textSize="?attr/c_title_size" />

    <FrameLayout
        android:id="@+id/widget_focus_ring_box"
        android:layout_width="176dp"
        android:layout_height="176dp"
        android:layout_marginTop="12dp">

        <com.unowhy.companion.ui.FocusDial
            android:id="@+id/widget_focus_dial"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_focus_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/c_font_display"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:textColor="?attr/c_text"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/widget_focus_phase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="?attr/c_font_regular"
                android:maxWidth="120dp"
                android:singleLine="true"
                android:textColor="?attr/c_text_dim"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/widget_focus_toggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/cadran_round_bg"
            android:clickable="true"
            android:contentDescription="@string/focus_start"
            android:focusable="true">

            <ImageView
                android:id="@+id/widget_focus_toggle_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="?attr/c_text" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_focus_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="?attr/c_font_regular"
            android:maxWidth="150dp"
            android:singleLine="true"
            android:textColor="?attr/c_text_faint"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
