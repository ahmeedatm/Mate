<?xml version="1.0" encoding="utf-8"?>
<!-- Témoin de l'ordinateur actif, pastille LCD à droite du bandeau du haut (thèmes à rangée de touches : la barre de gauche,
     qui la portait, n'y est pas). Sans texte (ComputerLamp) : le logo de l'ordinateur, une diode, des points s'il y en a
     plusieurs. Gonflée avec le style LCD du thème. Toucher : changer d'ordinateur ; TalkBack lit le nom et l'état. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chip_computer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/instrument_lcd_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:stateListAnimator="@animator/press"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="24dp">

            <ImageView
                android:id="@+id/chip_glyph"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center" />

            <ImageView
                android:id="@+id/chip_slash"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/lamp_slash"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/chip_dots"
            android:layout_width="wrap_content"
            android:layout_height="5dp"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="noHideDescendants">

        <ImageView
            android:id="@+id/chip_halo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:alpha="0.22"
            android:src="@drawable/lamp_halo" />

        <ImageView
            android:id="@+id/chip_led"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center" />
    </FrameLayout>
</LinearLayout>
