<?xml version="1.0" encoding="utf-8"?>
<!-- Caméra : d'abord un choix (montrer quelque chose sur l'écran de l'ordi, ou envoyer une photo à l'ordi),
     puis l'aperçu de la caméra arrière avec les commandes de l'usage choisi. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/camera_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/mode_camera"
            android:textSize="22sp" />

        <View
            android:id="@+id/camera_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/dot" />

        <TextView
            android:id="@+id/camera_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:textColor="?attr/c_text_dim"
            android:textSize="16sp" />

        <Button
            android:id="@+id/camera_stop"
            style="@style/ActionButton"
            android:drawableStart="@drawable/ic_back"
            android:text="@string/camera_back" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/camera_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <TextureView
            android:id="@+id/camera_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Écran de départ : les deux usages, expliqués. -->
        <LinearLayout
            android:id="@+id/camera_choice"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/camera_choose_show"
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="28dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_display"
                    android:tint="?attr/c_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/camera_choose_show"
                    android:textColor="?attr/c_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/camera_choose_show_hint"
                    android:textColor="?attr/c_text_dim"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/camera_choose_photo"
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="28dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_camera"
                    android:tint="?attr/c_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/camera_choose_photo"
                    android:textColor="?attr/c_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/camera_choose_photo_hint"
                    android:textColor="?attr/c_text_dim"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/camera_message_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/card_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/camera_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxWidth="480dp"
                android:textColor="?attr/c_text_dim"
                android:textSize="18sp" />

            <!-- Autoriser (permission refusée). -->
            <Button
                android:id="@+id/camera_action"
                style="@style/PrimaryButton"
                android:layout_marginTop="16dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/camera_frozen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/banner_bg"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:text="@string/camera_frozen_hint"
            android:textColor="?attr/c_warn"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Montrer sur l'ordi : la fenêtre s'ouvre seule ; ce bandeau n'apparaît que si elle a été fermée. -->
        <LinearLayout
            android:id="@+id/camera_closed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/banner_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/camera_window_closed"
                android:textColor="?attr/c_text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/camera_show"
                style="@style/ActionButton"
                android:layout_marginStart="12dp"
                android:drawableStart="@drawable/ic_display"
                android:text="@string/camera_show_on_mac" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/camera_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/camera_freeze"
            style="@style/PrimaryButton"
            android:drawableStart="@drawable/ic_pause"
            android:minWidth="150dp"
            android:text="@string/camera_freeze" />

        <!-- Pastilles de zoom, ajoutées par CameraFragment selon le zoom maximal de la caméra. -->
        <LinearLayout
            android:id="@+id/camera_zooms"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <Button
            android:id="@+id/camera_photo"
            style="@style/ActionButton"
            android:drawableStart="@drawable/ic_camera"
            android:text="@string/camera_photo" />
    </LinearLayout>
</LinearLayout>
