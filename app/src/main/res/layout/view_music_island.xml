<?xml version="1.0" encoding="utf-8"?>
<!-- Îlot du lecteur ouvert (MusicIsland), posé par-dessus l'écran sous la pastille, à la manière de la Dynamic Island :
     pochette, titre et artiste en entier, barres qui dansent, avancement, boutons sans fond. Fond, couleurs, place et
     découpe posés par le code (encre foncée du thème, MiniPlayerLogic.islandInverted). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/island_panel"
    android:layout_width="@dimen/music_island_width"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/island_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/island_thumb"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/cover_bg"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/island_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="?attr/c_font_medium"
                    android:maxLines="2"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/island_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="?attr/c_font_regular"
                    android:maxLines="1"
                    android:textSize="15sp" />
            </LinearLayout>

            <app.mate.ui.IslandBars
                android:id="@+id/island_bars"
                android:layout_width="25dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/island_timeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/island_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/c_font_regular"
                android:fontFeatureSettings="tnum"
                android:minWidth="40dp"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/island_progress"
                style="@style/Slider"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/media_seek"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:id="@+id/island_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/c_font_regular"
                android:fontFeatureSettings="tnum"
                android:gravity="end"
                android:minWidth="40dp"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/island_previous"
                style="@style/IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@null"
                android:contentDescription="@string/media_previous"
                android:padding="14dp"
                android:src="@drawable/ic_skip_previous" />

            <ImageButton
                android:id="@+id/island_play"
                style="@style/IconButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:background="@null"
                android:contentDescription="@string/media_play_pause"
                android:padding="14dp"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/island_next"
                style="@style/IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@null"
                android:contentDescription="@string/media_next"
                android:padding="14dp"
                android:src="@drawable/ic_skip" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
