<?xml version="1.0" encoding="utf-8"?>
<!-- Îlot du lecteur ouvert (MusicIsland), posé par-dessus l'écran sous la pastille : pochette, titre et artiste en entier,
     barre d'avancement, grands boutons Précédent, Lecture / Pause, Suivant. Place et découpe posées par le code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/island_panel"
    android:layout_width="@dimen/music_island_width"
    android:layout_height="wrap_content"
    android:background="@drawable/music_island_bg"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/island_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/island_thumb"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/cover_bg"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/island_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="?attr/c_font_medium"
                    android:maxLines="3"
                    android:textColor="?attr/c_text"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/island_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="?attr/c_font_regular"
                    android:maxLines="2"
                    android:textColor="?attr/c_text_dim"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/island_timeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <SeekBar
                android:id="@+id/island_progress"
                style="@style/Slider"
                android:layout_width="match_parent"
                android:contentDescription="@string/media_seek"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/island_position"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="?attr/c_font_regular"
                    android:fontFeatureSettings="tnum"
                    android:textColor="?attr/c_text_dim"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/island_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="?attr/c_font_regular"
                    android:fontFeatureSettings="tnum"
                    android:textColor="?attr/c_text_dim"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/island_previous"
                style="@style/IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/media_previous"
                android:padding="15dp"
                android:src="@drawable/ic_skip_previous" />

            <ImageButton
                android:id="@+id/island_play"
                style="@style/IconButton.Primary"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:contentDescription="@string/media_play_pause"
                android:padding="17dp"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/island_next"
                style="@style/IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/media_next"
                android:padding="15dp"
                android:src="@drawable/ic_skip" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
