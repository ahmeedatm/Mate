<?xml version="1.0" encoding="utf-8"?>
<!-- Boîte Eau : verres bus aujourd'hui, − pour corriger, + au-delà de l'objectif compris. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/water_today_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="?attr/c_font_medium"
        android:textColor="?attr/c_text"
        android:textSize="20sp" />

    <ImageButton
        android:id="@+id/water_today_minus"
        style="@style/IconButton.Flat"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:contentDescription="@string/water_minus"
        android:src="@drawable/ic_remove" />

    <ImageButton
        android:id="@+id/water_today_plus"
        style="@style/IconButton.Primary"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:backgroundTint="?attr/c_hue_cyan"
        android:padding="13dp"
        android:contentDescription="@string/water_plus"
        android:src="@drawable/ic_add" />
</LinearLayout>
