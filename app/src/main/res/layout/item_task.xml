<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/row_bg"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <CheckBox
        android:id="@+id/task_check"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:scaleX="1.25"
        android:scaleY="1.25" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/task_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/task_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/c_text_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/task_open"
        style="@style/IconButton.Flat"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="11dp"
        android:contentDescription="@string/open_on_computer"
        android:src="@drawable/ic_open"
        app:tint="?attr/c_accent" />

    <ImageButton
        android:id="@+id/task_delete"
        style="@style/IconButton.Flat"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="12dp"
        android:contentDescription="@string/delete"
        android:src="@drawable/ic_close" />
</LinearLayout>
