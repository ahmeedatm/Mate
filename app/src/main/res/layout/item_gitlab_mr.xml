<?xml version="1.0" encoding="utf-8"?>
<!-- Une MR dans l'onglet GitLab : projet!numéro, titre, auteur, pipeline, approbations, état de fusion, bouton Fusionner. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/row_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/gitlab_ref"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/c_text_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/gitlab_draft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/gitlab_draft"
            android:textColor="?attr/c_text_faint"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/gitlab_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="?attr/c_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/gitlab_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/c_text_dim"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/gitlab_pipeline_dot"
            android:layout_width="10dp"
            android:layout_height="10dp" />

        <TextView
            android:id="@+id/gitlab_pipeline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/c_text"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/gitlab_approvals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="?attr/c_text_dim"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/gitlab_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="?attr/c_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Refus de GitLab ou échec de la dernière action sur cette MR. -->
    <TextView
        android:id="@+id/gitlab_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/c_ko"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Bouton Fusionner (HoldButton, créé dans le code : il n'a que le constructeur à contexte) et son indication. -->
    <LinearLayout
        android:id="@+id/gitlab_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal" />
</LinearLayout>
