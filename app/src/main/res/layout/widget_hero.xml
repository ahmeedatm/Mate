<?xml version="1.0" encoding="utf-8"?>
<!-- Héros de l'Accueil (HeroWidget, DA Cadran) : heure en grand qui bascule, date, « Ensuite … », météo et eau à droite.
     Sans fond : le héros n'est pas une tuile. Il déborde de quelques dp sous sa ligne, comme dans la maquette. -->
<app.mate.ui.home.HeroView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hero"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/hero_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:clipChildren="false"
        android:orientation="vertical">

        <app.mate.ui.RollingText
            android:id="@+id/hero_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-10dp" />

        <TextView
            android:id="@+id/hero_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:layout_marginTop="6dp"
            android:fontFamily="?attr/c_font_regular"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="?attr/c_text_dim"
            android:textSize="26sp" />

        <LinearLayout
            android:id="@+id/hero_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Ordinateur injoignable : seul message de l'Accueil, à la place de « Ensuite ». -->
            <TextView
                android:id="@+id/hero_next_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="?attr/c_font_medium"
                android:includeFontPadding="false"
                android:maxWidth="560dp"
                android:singleLine="true"
                android:textColor="?attr/c_warn"
                android:textSize="17sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hero_next_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:fontFamily="?attr/c_font_regular"
                android:includeFontPadding="false"
                android:text="@string/next_prefix"
                android:textColor="?attr/c_text_dim"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/hero_next_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="?attr/c_font_medium"
                android:includeFontPadding="false"
                android:maxWidth="520dp"
                android:singleLine="true"
                android:textColor="?attr/c_text"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/hero_next_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="?attr/c_font_regular"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="?attr/c_text_dim"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/hero_next_in"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="?attr/c_font_medium"
                    android:includeFontPadding="false"
                    android:text="@string/hero_in"
                    android:textColor="?attr/c_accent"
                    android:textSize="17sp" />

                <app.mate.ui.RollingText
                    android:id="@+id/hero_next_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="?attr/c_font_medium"
                    android:includeFontPadding="false"
                    android:text="@string/hero_min"
                    android:textColor="?attr/c_accent"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/hero_compl"
        layout="@layout/view_hero_compl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end" />
</app.mate.ui.home.HeroView>
