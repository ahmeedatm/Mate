<?xml version="1.0" encoding="utf-8"?>
<!-- Contenu de WindowPicker (FrameLayout plein écran sur fond assombri). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/picker_card"
        style="@style/Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="40dp"
        android:clickable="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/picker_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="14dp"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/picker_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/picker_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/c_text_dim"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Page Apps seulement : retirer l'appli du deck. -->
            <Button
                android:id="@+id/picker_remove"
                style="@style/ActionButton"
                android:layout_marginEnd="8dp"
                android:drawableStart="@drawable/ic_delete"
                android:text="@string/apps_remove"
                android:visibility="gone" />

            <Button
                android:id="@+id/picker_activate"
                style="@style/ActionButton"
                android:drawableStart="@drawable/ic_open"
                android:text="@string/windows_activate_app" />

            <ImageButton
                android:id="@+id/picker_close"
                style="@style/IconButton.Flat"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/picker_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?attr/c_text_dim"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Écrans du Mac, placés comme sur le bureau, avec leurs fenêtres. -->
        <com.unowhy.companion.ui.ScreenMap
            android:id="@+id/picker_map"
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:layout_marginTop="16dp" />

        <!-- Fenêtres des autres bureaux (Spaces, plein écran caché) : la toucher fait passer sur son bureau. -->
        <LinearLayout
            android:id="@+id/picker_elsewhere"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.unowhy.companion.ui.TitleView
                style="@style/CardTitle"
                android:layout_marginEnd="12dp"
                android:text="@string/windows_elsewhere" />

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/picker_elsewhere_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <TextView
            android:id="@+id/picker_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/windows_hint"
            android:textColor="?attr/c_text_faint"
            android:textSize="13sp" />
    </LinearLayout>
</merge>
