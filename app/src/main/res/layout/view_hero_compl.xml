<?xml version="1.0" encoding="utf-8"?>
<!-- Complications du bandeau de l'Accueil (HeroComplications) : météo et eau, à droite de l'heure (HeroWidget) ou de
     Ma journée (DayWidget). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hero_compl"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="top|end"
    android:orientation="horizontal"
    android:paddingTop="22dp">

    <LinearLayout
        android:id="@+id/hero_weather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hero_wx_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:drawablePadding="10dp"
            app:drawableTint="?attr/c_text_dim"
            android:fontFamily="?attr/c_font_display"
            android:fontFeatureSettings="tnum"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:singleLine="true"
            android:textColor="?attr/c_text"
            android:textSize="52sp" />

        <TextView
            android:id="@+id/hero_wx_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:layout_marginTop="2dp"
            android:fontFamily="?attr/c_font_regular"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="?attr/c_text_dim"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hero_water"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="40dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="end"
        android:orientation="vertical">

        <com.unowhy.companion.ui.home.GlassBars
            android:id="@+id/hero_glasses"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.unowhy.companion.ui.RollingText
                android:id="@+id/hero_glasses_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/hero_glasses_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="?attr/c_font_regular"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="?attr/c_text_dim"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
