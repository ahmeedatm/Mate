<?xml version="1.0" encoding="utf-8"?>
<!-- Panneau du menu Cadran : Parler, destinations (remplies par MenuPanel), pied (ordinateur, heure, WiFi, batterie). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menu_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/menu_panel_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="20dp"
    android:paddingEnd="12dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:id="@+id/menu_talk"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/menu_talk_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="22dp">

        <ImageView
            android:id="@+id/rail_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_mic"
            app:tint="?attr/c_bg" />

        <TextView
            android:id="@+id/rail_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="?attr/c_font_medium"
            android:text="@string/voice_button"
            android:textColor="?attr/c_bg"
            android:textSize="16sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Fond de la destination choisie : glisse de rangée en rangée (ressort). -->
        <View
            android:id="@+id/menu_ind"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/menu_ind_bg" />

        <LinearLayout
            android:id="@+id/menu_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Ordinateur piloté et pastille de connexion ; toucher : changer d'ordinateur. -->
    <LinearLayout
        android:id="@+id/menu_status"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_laptop"
            app:tint="?attr/c_text_dim" />

        <TextView
            android:id="@+id/menu_status_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxWidth="190dp"
            android:singleLine="true"
            android:textColor="?attr/c_text_dim"
            android:textSize="14sp" />

        <View
            android:id="@+id/menu_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/dot" />
    </LinearLayout>
</LinearLayout>
