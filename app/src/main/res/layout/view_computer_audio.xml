<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageButton
        android:id="@+id/audio_mute"
        style="@style/IconButton"
        android:contentDescription="@string/mute_toggle"
        android:src="@drawable/ic_volume" />

    <SeekBar
        android:id="@+id/audio_volume"
        style="@style/Slider"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:max="100" />

    <TextView
        android:id="@+id/audio_value"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="?attr/c_text_dim"
        android:textSize="15sp" />

    <ImageButton
        android:id="@+id/audio_mic"
        style="@style/IconButton"
        android:layout_marginStart="12dp"
        android:contentDescription="@string/mic_toggle"
        android:src="@drawable/ic_mic" />
</merge>
