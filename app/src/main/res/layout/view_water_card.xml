<?xml version="1.0" encoding="utf-8"?>
<!-- Carte Eau de l'Accueil (WaterCard) : verres du jour sur l'objectif, + / −, toucher le titre = réglages. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/water_header"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/flat_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.unowhy.companion.ui.TitleView
                style="@style/CardTitle"
                android:drawableStart="@drawable/ic_water"
                android:text="@string/water_title"
                android:textColor="?attr/c_hue_cyan" />

            <TextView
                android:id="@+id/water_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textSize="17sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/water_minus"
            style="@style/IconButton.Flat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:contentDescription="@string/water_minus"
            android:src="@drawable/ic_remove" />

        <ImageButton
            android:id="@+id/water_plus"
            style="@style/IconButton.Primary"
            android:layout_width="48dp"
            android:backgroundTint="?attr/c_hue_cyan"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:padding="13dp"
            android:contentDescription="@string/water_plus"
            android:src="@drawable/ic_add" />
    </LinearLayout>

    <!-- Un segment par verre de l'objectif, rempli au fil de la journée. -->
    <LinearLayout
        android:id="@+id/water_gauge"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal" />
</merge>
