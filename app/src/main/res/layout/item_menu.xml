<?xml version="1.0" encoding="utf-8"?>
<!-- Une destination du menu Cadran ; l'état sélectionné (isSelected) colore l'icône et le libellé. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rail_label"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:drawablePadding="16dp"
    app:drawableTint="@color/menu_content"
    android:focusable="true"
    android:fontFamily="?attr/c_font_medium"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:singleLine="true"
    android:textColor="@color/menu_content"
    android:textSize="16sp" />
