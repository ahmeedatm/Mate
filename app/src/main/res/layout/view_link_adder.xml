<?xml version="1.0" encoding="utf-8"?>
<!-- Contenu de LinkAdder (FrameLayout plein écran sur fond assombri) : ajouter un site à la page Média. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        style="@style/Card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="24dp"
        android:clickable="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/links_add_title"
                android:textSize="20sp" />

            <ImageButton
                android:id="@+id/links_close"
                style="@style/IconButton.Flat"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/links_custom"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/links_url"
                style="@style/Input"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:hint="@string/links_url_hint"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:singleLine="true" />

            <EditText
                android:id="@+id/links_name"
                style="@style/Input"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="@string/links_name_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text|textCapSentences"
                android:singleLine="true" />

            <Button
                android:id="@+id/links_add"
                style="@style/PrimaryButton"
                android:layout_marginStart="8dp"
                android:text="@string/links_add" />
        </LinearLayout>

        <TextView
            android:id="@+id/links_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_dim"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/links_suggestions"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/links_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</merge>
