<?xml version="1.0" encoding="utf-8"?>
<!-- Lecture en cours dans le header (MusicChip, largeur fixe) : pochette et titre seulement (qui défile trois fois s'il
     est trop long), sur 32 dp de haut. Un toucher ouvre l'îlot (MusicIsland, view_music_island). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <ImageView
        android:id="@+id/chip_thumb"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/cover_bg"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/chip_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:fontFamily="?attr/c_font_regular"
        android:importantForAccessibility="no"
        android:textColor="?attr/c_text"
        android:textSize="13sp" />
</merge>
