<?xml version="1.0" encoding="utf-8"?>
<!-- Écran Profils (HomeFragment, WidgetGrid) : le profil se choisit dans la barre fixe de gauche, appui long sur la
     grille = mode Modifier, avec sa barre. Panneau document ouvert : 2 colonnes, la page défile. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/home_edit_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_edit_hint"
                android:textColor="?attr/c_text_dim"
                android:textSize="15sp" />

            <Button
                android:id="@+id/home_edit_add"
                style="@style/ActionButton"
                android:drawableStart="@drawable/ic_add"
                android:text="@string/home_edit_add" />

            <Button
                android:id="@+id/home_edit_cancel"
                style="@style/ActionButton"
                android:layout_marginStart="8dp"
                android:text="@string/cancel" />

            <Button
                android:id="@+id/home_edit_done"
                style="@style/PrimaryButton"
                android:layout_marginStart="8dp"
                android:text="@string/home_edit_done" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/home_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <app.mate.ui.home.WidgetGrid
                android:id="@+id/home_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp" />
        </ScrollView>
    </LinearLayout>

    <!-- Plus aucun écran (tous supprimés, Accueil compris) : l'heure et la date seules, de quoi en ajouter un en bas. -->
    <FrameLayout
        android:id="@+id/home_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/c_font_display"
                android:fontFeatureSettings="tnum"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="?attr/c_text"
                android:textSize="160sp" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="?attr/c_font_regular"
                android:format12Hour="EEEE d MMMM"
                android:format24Hour="EEEE d MMMM"
                android:textColor="?attr/c_text_dim"
                android:textSize="24sp" />
        </LinearLayout>

        <Button
            android:id="@+id/home_empty_add"
            style="@style/ActionButton"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="40dp"
            android:drawableStart="@drawable/ic_add"
            android:text="@string/home_empty_add" />
    </FrameLayout>
</FrameLayout>
