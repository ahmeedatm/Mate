<?xml version="1.0" encoding="utf-8"?>
<!-- Une touche de la rangée d'Instrument : la DEL au-dessus (segments posés par KeyDock), le socle fixe, puis le capuchon
     (numéro en haut à gauche, icône au trait et libellé) qui s'enfonce quand on appuie ou que la touche est active. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_weight="1"
    android:clickable="true"
    android:clipChildren="false"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/dock_led"
        android:layout_width="wrap_content"
        android:layout_height="5dp"
        android:layout_gravity="top|center_horizontal"
        android:importantForAccessibility="no"
        android:orientation="horizontal" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="18dp"
        android:background="@drawable/dock_key_base"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/dock_cap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/dock_key_cap"
        android:duplicateParentState="true">

        <TextView
            android:id="@+id/dock_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:fontFamily="?attr/c_font_display"
            android:textColor="?attr/c_text_dim"
            android:textSize="14sp" />

        <!-- Groupe centré, descendu sous le numéro pour ne jamais le chevaucher, même à grande police. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dock_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                app:tint="?attr/c_text" />

            <!-- 140 dp suffisent à « RÉGLAGES » à font_scale 1.3 ; au-delà, le libellé se coupe (la description reste). -->
            <TextView
                android:id="@+id/dock_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:fontFamily="?attr/c_font_label"
                android:letterSpacing="0.08"
                android:singleLine="true"
                android:textAllCaps="?attr/c_label_caps"
                android:textColor="?attr/c_text"
                android:maxWidth="140dp"
                android:textSize="17sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/dock_badge"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/badge_bg"
            android:gravity="center"
            android:minWidth="18dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:textColor="?attr/c_on_ko"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
