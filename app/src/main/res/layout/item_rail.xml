<?xml version="1.0" encoding="utf-8"?>
<!-- Un mode dans la barre latérale ; l'état sélectionné (isSelected) colore l'icône et le libellé. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="76dp"
    android:layout_height="74dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/rail_item_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/rail_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            app:tint="@color/rail_content" />

        <TextView
            android:id="@+id/rail_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:textColor="@color/rail_content"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/rail_badge"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/badge_bg"
        android:gravity="center"
        android:minWidth="20dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:textColor="@color/paper"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
