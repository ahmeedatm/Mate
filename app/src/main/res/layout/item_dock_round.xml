<?xml version="1.0" encoding="utf-8"?>
<!-- Touche ronde aux deux bouts de la rangée d'Instrument (Parler à gauche, Verrou à droite) : socle fixe et capuchon,
     comme les autres touches. Le fond du capuchon et l'icône sont posés par KeyDock. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="64dp"
    android:layout_height="64dp"
    android:layout_gravity="bottom"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:clickable="true"
    android:focusable="true">

    <View
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/dock_round_base"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/dock_round_cap"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/dock_round_cap"
        android:duplicateParentState="true"
        android:stateListAnimator="@animator/dock_key">

        <ImageView
            android:id="@+id/dock_round_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="?attr/c_text" />
    </FrameLayout>
</FrameLayout>
