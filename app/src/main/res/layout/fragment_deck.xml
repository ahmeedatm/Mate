<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Onglets des pages du deck (générés depuis config/deck.json sur le Mac). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- fillViewport : la rangée d'onglets prend toute la largeur, un onglet déplacé n'est pas coupé après le dernier. -->
            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/deck_tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ImageButton
                android:id="@+id/deck_refresh"
                style="@style/IconButton.Flat"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/refresh"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <!-- Mac sans l'autorisation Accessibilité : fenêtres et raccourcis ne marchent pas, le bouton ouvre le réglage. -->
        <LinearLayout
            android:id="@+id/deck_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_warn_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/deck_access_missing"
                android:textColor="?attr/c_text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/deck_access_open"
                style="@style/PrimaryButton"
                android:layout_marginStart="16dp"
                android:text="@string/deck_access_open" />
        </LinearLayout>

        <!-- Son et micro du Mac. Les boutons de volume de la tablette pilotent aussi le Mac dans ce mode. -->
        <com.unowhy.companion.ui.ComputerAudioView
            android:id="@+id/deck_audio"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <!-- Page d'une appli (Discord…) : son de cette appli seule, et témoin quand quelqu'un parle. -->
        <com.unowhy.companion.ui.AppAudioView
            android:id="@+id/deck_app_audio"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <!-- Page d'une appli d'appel (Discord, Windows) : salon ou appel en cours et participants. -->
        <LinearLayout
            android:id="@+id/deck_voice"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/deck_voice_channel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/c_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/deck_voice_people"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/c_text_dim"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Page Média : ce qui joue sur l'ordinateur (YouTube, Twitch, Spotify…) et ses commandes. -->
        <com.unowhy.companion.ui.NowPlayingView
            android:id="@+id/deck_now_playing"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp" />

        <GridView
            android:id="@+id/deck_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:columnWidth="136dp"
            android:horizontalSpacing="14dp"
            android:listSelector="@android:color/transparent"
            android:numColumns="auto_fit"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="14dp" />

        <!-- Onglet « Ouvertes » : toutes les fenêtres de l'ordinateur sur le schéma de ses écrans (à la place des touches). -->
        <com.unowhy.companion.ui.OpenWindowsView
            android:id="@+id/deck_open"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1" />

        <!-- Onglet « Son » : console de mixage de l'ordinateur (sortie, micro, applis, scènes). -->
        <com.unowhy.companion.ui.mixer.MixerView
            android:id="@+id/deck_mixer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <!-- Onglet « Agents » : les sessions Claude Code de l'ordinateur (qui travaille, qui a fini, qui attend). -->
        <com.unowhy.companion.ui.AgentsView
            android:id="@+id/deck_agents"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <!-- Onglet « Pavé » : la tablette devient le pavé tactile de l'ordinateur. -->
        <com.unowhy.companion.ui.pointer.PadView
            android:id="@+id/deck_pad"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/deck_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="?attr/c_text_dim"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Fenêtres d'une appli (plusieurs fenêtres, ou appui long sur la tuile). -->
    <com.unowhy.companion.ui.WindowPicker
        android:id="@+id/deck_windows"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Ajout d'applis du Mac à la page Apps. -->
    <com.unowhy.companion.ui.AppAdder
        android:id="@+id/deck_adder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Ajout de sites à la page Média. -->
    <com.unowhy.companion.ui.LinkAdder
        android:id="@+id/deck_links"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Programmation d'une touche de la page Perso. -->
    <com.unowhy.companion.ui.KeyEditor
        android:id="@+id/deck_editor"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
