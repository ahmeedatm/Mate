<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Appui long : code technicien, qui montre la carte Kiosque. -->
        <TextView
            android:id="@+id/settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="?attr/c_font_title"
            android:text="@string/mode_settings"
            android:textSize="28sp" />

        <!-- Ordinateurs appairés (bureau, maison…) : celui que la tablette pilote, les autres en relais. -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <com.unowhy.companion.ui.TitleView
                style="@style/CardTitle"
                android:drawableStart="@drawable/ic_display"
                android:text="@string/computers_title" />

            <TextView
                android:id="@+id/settings_computers_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/computers_hint"
                android:textColor="?attr/c_text_dim"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/settings_computers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/settings_add_computer"
                    style="@style/PrimaryButton"
                    android:drawableStart="@drawable/ic_add"
                    android:text="@string/computer_add" />

                <Button
                    android:id="@+id/settings_add_manual"
                    style="@style/ActionButton"
                    android:layout_marginStart="12dp"
                    android:text="@string/computer_add_manual" />
            </LinearLayout>
        </LinearLayout>

        <!-- Plugins de l'ordinateur actif : le même écran qu'à la première utilisation. -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <com.unowhy.companion.ui.TitleView
                style="@style/CardTitle"
                android:drawableStart="@drawable/ic_widgets"
                android:text="@string/plugins_card" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/plugins_hint"
                android:textColor="?attr/c_text_dim"
                android:textSize="14sp" />

            <Button
                android:id="@+id/settings_plugins"
                style="@style/ActionButton"
                android:layout_marginTop="16dp"
                android:text="@string/plugins_choose" />
        </LinearLayout>

        <!-- WiFi : en kiosque, Paramètres d'Android est inaccessible. -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.unowhy.companion.ui.TitleView
                    style="@style/CardTitle"
                    android:drawableStart="@drawable/ic_wifi"
                    android:text="@string/wifi_title" />

                <TextView
                    android:id="@+id/settings_wifi_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="16sp" />
            </LinearLayout>

            <Button
                android:id="@+id/settings_wifi"
                style="@style/ActionButton"
                android:text="@string/wifi_choose" />
        </LinearLayout>

        <!-- Accessibilité malgré le kiosque (device/Accessibility) : TalkBack et taille du texte de l'appli. -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <com.unowhy.companion.ui.TitleView
                style="@style/CardTitle"
                android:drawableStart="@drawable/ic_accessibility"
                android:text="@string/a11y_title" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/settings_talkback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/a11y_talkback"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/settings_talkback_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/a11y_talkback_hint"
                android:textColor="?attr/c_text_dim"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/a11y_text_size"
                android:textColor="?attr/c_text"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/settings_text_sizes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- Thème : ambiances prédéfinies (ui/Themes.kt), pastilles ajoutées par SettingsFragment. -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <com.unowhy.companion.ui.TitleView
                style="@style/CardTitle"
                android:drawableStart="@drawable/ic_palette"
                android:text="@string/theme_title" />

            <LinearLayout
                android:id="@+id/settings_themes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- Tablette : ce que le kiosque cache (batterie, luminosité, volume, version, adresse). -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <com.unowhy.companion.ui.TitleView
                style="@style/CardTitle"
                android:drawableStart="@drawable/ic_tablet"
                android:text="@string/tablet_title" />

            <TextView
                android:id="@+id/settings_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/settings_battery_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/c_text_dim"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/tablet_brightness"
                    android:src="@drawable/ic_brightness"
                    app:tint="?attr/c_text_dim" />

                <SeekBar
                    android:id="@+id/settings_brightness"
                    style="@style/Slider"
                    android:layout_width="0dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/tablet_brightness"
                    android:max="100" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/tablet_volume"
                    android:src="@drawable/ic_volume"
                    app:tint="?attr/c_text_dim" />

                <SeekBar
                    android:id="@+id/settings_volume"
                    style="@style/Slider"
                    android:layout_width="0dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/tablet_volume" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/settings_night_dim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:text="@string/tablet_night_dim"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tablet_night_dim_hint"
                android:textColor="?attr/c_text_dim"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/settings_notif_discreet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/notif_discreet"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notif_discreet_hint"
                android:textColor="?attr/c_text_dim"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/settings_wake_word"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/wake_word"
                android:textSize="16sp" />

            <!-- État du mot de réveil : prêt, téléchargement du modèle, micro non autorisé, modèle indisponible. -->
            <TextView
                android:id="@+id/settings_wake_word_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wake_ready"
                android:textColor="?attr/c_text_dim"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/settings_weather_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/weather_location"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/weather_location_hint"
                android:textColor="?attr/c_text_dim"
                android:textSize="14sp" />

            <!-- Ouvre sur l'ordinateur la page du compagnon, carte Réglages de la tablette en avant. -->
            <Button
                android:id="@+id/settings_tablet_remote"
                style="@style/ActionButton"
                android:layout_marginTop="12dp"
                android:text="@string/tablet_remote" />

            <TextView
                android:id="@+id/settings_tablet_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="?attr/c_text_faint"
                android:textIsSelectable="false"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Mises à jour (moteur web, Companion) depuis le « serveur Unowhy » simulé par l'ordinateur. -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.unowhy.companion.ui.TitleView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_refresh"
                    android:text="@string/updates_title" />

                <!-- Stable : « Ouvrir l'essai » si l'appli d'essai est installée ; essai : « Revenir à la stable ». -->
                <Button
                    android:id="@+id/settings_switch_app"
                    style="@style/ActionButton"
                    android:layout_marginEnd="12dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/settings_updates_check"
                    style="@style/ActionButton"
                    android:text="@string/updates_check" />
            </LinearLayout>

            <TextView
                android:id="@+id/settings_updates_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/updates_hint"
                android:textColor="?attr/c_text_dim"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/settings_trial_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/trial_hint"
                android:textColor="?attr/c_text_dim"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/settings_updates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Compagnon de l'ordinateur actif : version, mise à jour envoyée par la tablette (installers/CompanionUpdater). -->
            <TextView
                android:id="@+id/settings_companion_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="?attr/c_text_dim"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/settings_companion_update"
                style="@style/PrimaryButton"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/settings_essais_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="?attr/c_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/settings_essais"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Réunions Teams de l'agenda : seulement si l'ordinateur a Teams dans sa page Apps. -->
        <LinearLayout
            android:id="@+id/settings_meetings_card"
            style="@style/Card"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <com.unowhy.companion.ui.TitleView
                style="@style/CardTitle"
                android:drawableStart="@drawable/ic_videocam"
                android:text="@string/settings_meetings" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/settings_autojoin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/autojoin"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/settings_autojoin_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/autojoin_hint"
                android:textColor="?attr/c_text_dim"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Kiosque : réservé au technicien (code), un client ne doit pas pouvoir en sortir ni le retirer. -->
        <LinearLayout
            android:id="@+id/settings_kiosk_card"
            style="@style/Card"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <com.unowhy.companion.ui.TitleView
                style="@style/CardTitle"
                android:drawableStart="@drawable/ic_lock"
                android:text="@string/kiosk_title" />

            <TextView
                android:id="@+id/settings_kiosk_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/settings_allow_installs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/kiosk_allow_installs"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/settings_allow_installs_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/kiosk_allow_installs_hint"
                android:textColor="?attr/c_text_dim"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/settings_kiosk_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button android:id="@+id/settings_kiosk_exit" style="@style/ActionButton" android:text="@string/kiosk_exit" />

                <Button
                    android:id="@+id/settings_kiosk_remove"
                    style="@style/ActionButton"
                    android:layout_marginStart="12dp"
                    android:text="@string/kiosk_remove"
                    android:textColor="?attr/c_ko" />
            </LinearLayout>
        </LinearLayout>

        <!-- À propos : sources des données et licences à citer (météo, villes, polices). -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <com.unowhy.companion.ui.TitleView
                style="@style/CardTitle"
                android:drawableStart="@drawable/ic_info"
                android:text="@string/about_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/about_sources"
                android:textColor="?attr/c_text_dim"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button android:id="@+id/settings_privacy" style="@style/ActionButton" android:text="@string/about_privacy" />

                <Button
                    android:id="@+id/settings_licences"
                    style="@style/ActionButton"
                    android:layout_marginStart="12dp"
                    android:text="@string/about_licences" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
