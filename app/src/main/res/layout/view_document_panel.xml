<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/doc_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:fontFamily="?attr/c_font_medium"
            android:singleLine="true"
            android:textSize="18sp" />

        <!-- Agrandir (presque tout l'écran, la barre latérale reste) ou revenir à côté du mode courant. -->
        <ImageButton
            android:id="@+id/doc_expand"
            style="@style/IconButton.Flat"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/doc_expand"
            android:src="@drawable/ic_fullscreen" />

        <!-- Page web : choisir un onglet ouvert sur l'ordinateur (en tête, celui qui y est affiché). -->
        <Button
            android:id="@+id/doc_web_tabs"
            style="@style/ActionButton"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:drawableStart="@drawable/ic_tabs"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="@string/web_tabs"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/doc_open_computer"
            style="@style/ActionButton"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:drawableStart="@drawable/ic_open"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="@string/open_on_computer"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/doc_close"
            style="@style/IconButton.Flat"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/doc_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/doc_image_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/doc_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
        </ScrollView>

        <ScrollView
            android:id="@+id/doc_text_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:id="@+id/doc_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:textIsSelectable="true"
                android:textSize="16sp"
                android:typeface="monospace" />
        </ScrollView>

        <TextView
            android:id="@+id/doc_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="?attr/c_text_dim"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/doc_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/doc_prev"
            style="@style/IconButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/previous"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:id="@+id/doc_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:minWidth="64dp"
            android:gravity="center"
            android:textColor="?attr/c_text_dim"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/doc_next"
            style="@style/IconButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/next"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>
</merge>
