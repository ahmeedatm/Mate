<?xml version="1.0" encoding="utf-8"?>
<!-- Depuis l'ordi : d'abord un choix (fichiers du dossier partagé, page ouverte dans le navigateur de l'ordi,
     presse-papiers), comme dans Caméra, puis la liste des fichiers ou l'écran Presse-papiers. L'historique des
     notifications s'affiche ici aussi, ouvert par la cloche en haut à gauche (activity_main.xml). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/docs_up"
            style="@style/IconButton"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/up"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/docs_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:fontFamily="?attr/c_font_title"
                android:singleLine="true"
                android:text="@string/docs_title"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/docs_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/c_text_dim"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/docs_refresh"
            style="@style/IconButton.Flat"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/refresh"
            android:src="@drawable/ic_refresh" />

        <Button
            android:id="@+id/docs_back"
            style="@style/ActionButton"
            android:drawableStart="@drawable/ic_back"
            android:text="@string/camera_back" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1">

        <!-- Écran de départ : les quatre usages, expliqués, dans un grand carré coupé en croix (cases translucides en Rétro). -->
        <com.unowhy.companion.ui.CrossSquareLayout
            android:id="@+id/docs_choice"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/docs_choose_files"
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="28dp"
                android:paddingTop="40dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_folder"
                    android:tint="?attr/c_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/docs_choose_files"
                    android:textColor="?attr/c_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/docs_choose_files_hint"
                    android:textColor="?attr/c_text_dim"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/docs_choose_web"
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="28dp"
                android:paddingTop="40dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_display"
                    android:tint="?attr/c_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/web_from_computer"
                    android:textColor="?attr/c_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/docs_choose_web_hint"
                    android:textColor="?attr/c_text_dim"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/docs_choose_clipboard"
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="28dp"
                android:paddingTop="40dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_clipboard"
                    app:tint="?attr/c_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/clip_choose"
                    android:textColor="?attr/c_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/clip_choose_hint"
                    android:textColor="?attr/c_text_dim"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/docs_choose_frame"
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="28dp"
                android:paddingTop="40dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_image"
                    app:tint="?attr/c_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/frame_title"
                    android:textColor="?attr/c_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/frame_choose_hint"
                    android:textColor="?attr/c_text_dim"
                    android:textSize="16sp" />
            </LinearLayout>
        </com.unowhy.companion.ui.CrossSquareLayout>

        <!-- Cadre photo : photos de l'ordi qui défilent quand la tablette ne sert pas, et quand. -->
        <include
            android:id="@+id/docs_frame"
            layout="@layout/view_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Presse-papiers : ce qui est copié sur l'ordi, et l'envoi d'un texte vers l'ordi. -->
        <include
            android:id="@+id/docs_clipboard"
            layout="@layout/view_clipboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Notifications : historique des notifications de l'ordinateur. -->
        <include
            android:id="@+id/docs_notifications"
            layout="@layout/view_notifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/docs_files"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ListView
                android:id="@+id/docs_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp"
                android:listSelector="@android:color/transparent"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/docs_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="16dp"
                android:textColor="?attr/c_text_dim"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
