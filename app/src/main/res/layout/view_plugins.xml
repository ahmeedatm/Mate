<?xml version="1.0" encoding="utf-8"?>
<!-- Plugins (PluginsView) : applis trouvées sur l'ordinateur à gauche, plugins intégrés à droite. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="40dp"
        android:paddingEnd="48dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="?attr/c_font_display"
            android:text="@string/plugins_title"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/plugins_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/c_text_dim"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="32dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <app.mate.ui.TitleView
                    style="@style/CardTitle"
                    android:drawableStart="@drawable/ic_laptop"
                    android:text="@string/plugins_apps" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/plugins_apps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>

            <LinearLayout
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <app.mate.ui.TitleView
                    style="@style/CardTitle"
                    android:drawableStart="@drawable/ic_tablet"
                    android:text="@string/plugins_native" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/plugins_native"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/plugins_later"
                style="@style/ActionButton"
                android:background="@drawable/flat_bg"
                android:text="@string/welcome_later"
                android:textColor="?attr/c_text_dim" />

            <Button
                android:id="@+id/plugins_save"
                style="@style/PrimaryButton"
                android:layout_marginStart="12dp"
                android:text="@string/plugins_save" />
        </LinearLayout>
    </LinearLayout>
</merge>
