<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Plusieurs applis jouent (navigateur et Spotify) : une pastille par appli, en haut sur toute la largeur, défilant si
         la place manque. -->
    <HorizontalScrollView
        android:id="@+id/media_sessions_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/media_sessions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>
    <!-- Lecture choisie : vignette (s'il y en a une) et textes, boutons à droite ; dessous en petit (NowPlayingView.layout). -->
    <LinearLayout
        android:id="@+id/media_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <!-- Vignette et textes. -->
        <LinearLayout
            android:id="@+id/media_main"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Vignette 16:9 (image de la vidéo, ou pochette centrée) ; absente tant qu'il n'y a pas d'image. -->
            <ImageView
                android:id="@+id/media_thumb"
                android:layout_width="128dp"
                android:layout_height="72dp"
                android:visibility="gone"
                android:background="@drawable/thumb_bg"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/media_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/c_text_dim"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/media_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="?attr/c_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/media_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/c_text_dim"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/media_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <SeekBar
                        android:id="@+id/media_progress"
                        style="@style/Slider"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:paddingStart="0dp" />

                    <TextView
                        android:id="@+id/media_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="?attr/c_text_dim"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/media_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/media_previous"
                style="@style/IconButton"
                android:layout_marginStart="16dp"
                android:contentDescription="@string/media_previous"
                android:src="@drawable/ic_skip_previous" />

            <ImageButton
                android:id="@+id/media_play"
                style="@style/IconButton.Primary"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/media_play_pause"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/media_next"
                style="@style/IconButton"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/media_next"
                android:src="@drawable/ic_skip" />
        </LinearLayout>
    </LinearLayout>
</merge>
