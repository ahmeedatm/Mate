<?xml version="1.0" encoding="utf-8"?>
<!-- HTTP en clair laissé permis pour les pages web du WebView (« Page de l'ordi ») et l'USB (127.0.0.1).
     L'ordinateur, lui, est joint en HTTPS épinglé en WiFi ; net/Http.kt n'envoie jamais le jeton en clair
     hors de 127.0.0.1 (docs/securite-appairage.md). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
