<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Companion" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlNormal">@color/text_dim</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_faint</item>
        <!-- Pas d'animations de fenêtre : la tablette est lente. -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Boutons -->

    <style name="ActionButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:background">@drawable/button_bg</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:drawableTint">@color/button_text</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="PrimaryButton" parent="ActionButton">
        <item name="android:background">@drawable/button_primary_bg</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:drawableTint">@color/on_accent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Pastille sélectionnable (onglets du deck, préréglages Focus, sons) : état via isSelected. -->
    <style name="Chip" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Bouton rond à icône. -->
    <style name="IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/round_bg</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/text</item>
    </style>

    <!-- Bouton à icône sans fond (barres d'outils, lignes de liste). -->
    <style name="IconButton.Flat">
        <item name="android:background">@drawable/flat_bg</item>
        <item name="tint">@color/text_dim</item>
    </style>

    <style name="IconButton.Primary">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:padding">15dp</item>
        <item name="android:background">@drawable/round_primary_bg</item>
        <item name="tint">@color/on_accent</item>
    </style>

    <!-- Cartes et textes -->

    <style name="Card">
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">20dp</item>
    </style>

    <style name="CardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableTint">@color/text_dim</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="SectionTitle" parent="CardTitle" />

    <style name="Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/input_bg</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_faint</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Slider">
        <item name="android:layout_height">48dp</item>
        <item name="android:progressTint">@color/accent</item>
        <item name="android:thumbTint">@color/accent</item>
        <item name="android:progressBackgroundTint">@color/text_faint</item>
    </style>
</resources>
