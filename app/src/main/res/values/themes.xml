<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème de lancement (MainActivity) : fenêtre système montrée pendant le cold start avec le logo, avant qu'onCreate
         pose le vrai thème (AppTheme.apply). Évite l'écran vide au démarrage. -->
    <style name="Theme.Companion.Launch" parent="Theme.Companion">
        <item name="android:windowBackground">@drawable/splash_window</item>
    </style>

    <style name="Theme.Companion" parent="Palette.Nuit">
        <item name="colorPrimary">?attr/c_accent</item>
        <item name="colorAccent">?attr/c_accent</item>
        <item name="colorControlNormal">?attr/c_text_dim</item>
        <item name="colorControlActivated">?attr/c_accent</item>
        <item name="android:windowBackground">?attr/c_bg</item>
        <item name="android:textColorPrimary">?attr/c_text</item>
        <item name="android:textColor">?attr/c_text</item>
        <item name="android:textColorHint">?attr/c_text_faint</item>
        <!-- Pas d'animations de fenêtre : la tablette est lente. -->
        <item name="android:windowAnimationStyle">@null</item>
        <item name="c_card_bg">@drawable/card_bg</item>
        <item name="c_tile_bg">@drawable/tile_bg</item>
        <item name="c_home_card_bg">@drawable/card_bg</item>
        <item name="c_card_pad">20dp</item>
        <item name="c_title_size">15sp</item>
        <item name="c_graphic">?attr/c_stroke</item>
        <item name="c_primary">?attr/c_accent</item>
        <item name="c_on_primary">?attr/c_on_accent</item>
        <item name="c_primary_pressed">?attr/c_text</item>
        <item name="c_font_medium">sans-serif-medium</item>
        <item name="c_font_light">sans-serif-light</item>
        <item name="c_font_regular">sans-serif</item>
        <item name="c_font_title">sans-serif-medium</item>
        <item name="c_font_display">sans-serif-light</item>
        <item name="alertDialogTheme">@style/CadranAlert</item>
    </style>

    <!-- Même thème sur fond clair (dialogues et champs de saisie d'AppCompat en version claire). -->
    <style name="Theme.CompanionLight" parent="Palette.Clair">
        <item name="colorPrimary">?attr/c_accent</item>
        <item name="colorAccent">?attr/c_accent</item>
        <item name="colorControlNormal">?attr/c_text_dim</item>
        <item name="colorControlActivated">?attr/c_accent</item>
        <item name="android:windowBackground">?attr/c_bg</item>
        <item name="android:textColorPrimary">?attr/c_text</item>
        <item name="android:textColor">?attr/c_text</item>
        <item name="android:textColorHint">?attr/c_text_faint</item>
        <!-- Pas d'animations de fenêtre : la tablette est lente. -->
        <item name="android:windowAnimationStyle">@null</item>
        <item name="c_card_bg">@drawable/card_bg</item>
        <item name="c_tile_bg">@drawable/tile_bg</item>
        <item name="c_home_card_bg">@drawable/card_bg</item>
        <item name="c_card_pad">20dp</item>
        <item name="c_title_size">15sp</item>
        <item name="c_graphic">?attr/c_stroke</item>
        <item name="c_primary">?attr/c_accent</item>
        <item name="c_on_primary">?attr/c_on_accent</item>
        <item name="c_primary_pressed">?attr/c_text</item>
        <item name="c_font_medium">sans-serif-medium</item>
        <item name="c_font_light">sans-serif-light</item>
        <item name="c_font_regular">sans-serif</item>
        <item name="c_font_title">sans-serif-medium</item>
        <item name="c_font_display">sans-serif-light</item>
        <item name="alertDialogTheme">@style/CadranAlert</item>
    </style>

    <!-- Boîtes de dialogue d'Android (AlertDialog) habillées comme celles de Cadran (CadranDialog) : fond du thème
         arrondi, titre en police de titre, boutons à l'accent. -->
    <style name="CadranAlert" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:windowTitleStyle">@style/CadranAlert.Title</item>
        <item name="buttonBarPositiveButtonStyle">@style/CadranAlert.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/CadranAlert.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/CadranAlert.Button</item>
    </style>

    <style name="CadranAlert.Title">
        <item name="android:maxLines">2</item>
        <item name="android:textAppearance">@style/CadranAlert.TitleText</item>
    </style>

    <style name="CadranAlert.TitleText" parent="TextAppearance.AppCompat.Title">
        <item name="android:fontFamily">?attr/c_font_title</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">?attr/c_text</item>
    </style>

    <style name="CadranAlert.Button" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:fontFamily">?attr/c_font_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/c_accent</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- Boutons -->

    <style name="ActionButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:background">@drawable/button_bg</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:drawableTint">@color/button_text</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:stateListAnimator">@animator/press</item>
    </style>

    <style name="PrimaryButton" parent="ActionButton">
        <item name="android:background">@drawable/button_primary_bg</item>
        <item name="android:textColor">?attr/c_on_primary</item>
        <item name="android:drawableTint">?attr/c_on_primary</item>
        <item name="android:fontFamily">?attr/c_font_medium</item>
    </style>

    <!-- Bouton en pilule de la DA Cadran (48 dp, rayon = moitié de la hauteur) : écran Presse-papiers. -->
    <style name="PillButton" parent="ActionButton">
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/pill_bg</item>
    </style>

    <style name="PillButton.Primary">
        <item name="android:background">@drawable/pill_primary_bg</item>
        <item name="android:textColor">@color/pill_primary_text</item>
        <item name="android:drawableTint">@color/pill_primary_text</item>
        <item name="android:fontFamily">?attr/c_font_medium</item>
    </style>

    <!-- Bouton rouge « maintenant » (Rejoindre, appel entrant) : garde l'accent dans tous les thèmes. -->
    <style name="NowButton" parent="ActionButton">
        <item name="android:background">@drawable/button_now_bg</item>
        <item name="android:textColor">?attr/c_on_accent</item>
        <item name="android:drawableTint">?attr/c_on_accent</item>
        <item name="android:fontFamily">?attr/c_font_medium</item>
    </style>

    <!-- Pastille sélectionnable (onglets du deck, préréglages Focus, sons) : état via isSelected. -->
    <style name="Chip" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:stateListAnimator">@animator/press</item>
    </style>

    <!-- Bouton rond à icône. -->
    <style name="IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/round_bg</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:stateListAnimator">@animator/press</item>
        <item name="tint">?attr/c_text</item>
    </style>

    <!-- Bouton à icône sans fond (barres d'outils, lignes de liste). -->
    <style name="IconButton.Flat">
        <item name="android:background">@drawable/flat_bg</item>
        <item name="tint">?attr/c_text_dim</item>
    </style>

    <style name="IconButton.Primary">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:padding">15dp</item>
        <item name="android:background">@drawable/round_primary_bg</item>
        <item name="tint">?attr/c_on_primary</item>
    </style>

    <!-- Cartes et textes -->

    <style name="Card">
        <item name="android:background">?attr/c_card_bg</item>
        <item name="android:padding">?attr/c_card_pad</item>
    </style>

    <style name="CardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:fontFamily">?attr/c_font_title</item>
        <item name="android:textColor">?attr/c_text_dim</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- Sous-titre d'une section dans une carte (Réglages > Mode kiosque). -->
    <style name="SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textColor">?attr/c_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Écran de bienvenue : numéro, titre et texte de chaque étape. -->
    <style name="WelcomeStep">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/step_bg</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/c_accent</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="WelcomeStepTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:fontFamily">?attr/c_font_medium</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="WelcomeStepText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">?attr/c_text_dim</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/input_bg</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textColor">?attr/c_text</item>
        <item name="android:textColorHint">?attr/c_text_faint</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Slider">
        <item name="android:layout_height">48dp</item>
        <item name="android:progressTint">?attr/c_accent</item>
        <item name="android:thumbTint">?attr/c_accent</item>
        <item name="android:progressBackgroundTint">?attr/c_text_faint</item>
    </style>
</resources>
