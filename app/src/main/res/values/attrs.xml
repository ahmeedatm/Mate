<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Couleurs du thème (valeurs dans palettes.xml) : dans les vues, ?attr/c_… ; dans le code, themeColor(context, R.attr.c_…). -->
    <attr name="c_bg" format="color" />
    <attr name="c_rail" format="color" />
    <attr name="c_surface" format="color" />
    <attr name="c_surface_raised" format="color" />
    <attr name="c_surface_pressed" format="color" />
    <attr name="c_stroke" format="color" />
    <!-- Ton des traits qui portent un sens (graduations éteintes, piste, poignée) : ≥ 3:1 sur le fond, la tuile et le relief. -->
    <attr name="c_graphic" format="color" />
    <attr name="c_accent" format="color" />
    <attr name="c_accent_soft" format="color" />
    <attr name="c_on_accent" format="color" />
    <attr name="c_text" format="color" />
    <!-- Cadre photo : fond autour d'une photo en portrait, heure par-dessus les photos et son ombre. -->
    <attr name="c_frame_bg" format="color" />
    <attr name="c_frame_text" format="color" />
    <attr name="c_frame_shadow" format="color" />
    <attr name="c_text_dim" format="color" />
    <attr name="c_text_faint" format="color" />
    <attr name="c_ok" format="color" />
    <attr name="c_ok_soft" format="color" />
    <attr name="c_ko" format="color" />
    <attr name="c_ko_soft" format="color" />
    <!-- Texte posé sur c_ko (pastille du nombre de tâches) : 4,5:1 au moins dans chaque palette. -->
    <attr name="c_on_ko" format="color" />
    <attr name="c_warn" format="color" />
    <attr name="c_paper" format="color" />
    <!-- Agents Claude : une session attend (ambre), a fini (vert), a atteint sa limite (bleu). Signaux, pas décor : lisibles sur chaque thème. -->
    <attr name="c_agent_wait" format="color" />
    <attr name="c_agent_done" format="color" />
    <attr name="c_agent_limit" format="color" />
    <!-- Une session travaille (roue qui tourne), surveille une tâche de fond (écran), comme dans Orca. -->
    <attr name="c_agent_work" format="color" />
    <attr name="c_agent_monitor" format="color" />
    <attr name="c_scrim" format="color" />
    <!-- Teintes des fonctions (pastilles des titres, tuiles d'applis) : ui/Look.kt. -->
    <attr name="c_hue_orange" format="color" />
    <attr name="c_hue_green" format="color" />
    <attr name="c_hue_cyan" format="color" />
    <attr name="c_hue_violet" format="color" />
    <attr name="c_hue_red" format="color" />
    <attr name="c_hue_pink" format="color" />
    <attr name="c_hue_yellow" format="color" />
    <attr name="c_hue_blue" format="color" />
    <!-- Habillage des tuiles : posé par chaque palette (palettes.xml). -->
    <attr name="c_card_bg" format="reference" />
    <attr name="c_tile_bg" format="reference" />
    <attr name="c_card_pad" format="dimension" />
    <!-- Fond des widgets de l'Accueil : celui des tuiles. -->
    <attr name="c_home_card_bg" format="reference" />
    <!-- Taille des titres de carte (TitleView) : 15 sp, 18 sp en Contraste élevé. -->
    <attr name="c_title_size" format="dimension" />
    <!-- Contraste élevé : grandes touches (cases de 148 dp, libellé de 18 sp) dans les grilles de touches (ui/home/TileGridView). -->
    <attr name="c_big_keys" format="boolean" />
    <attr name="c_primary" format="color" />
    <attr name="c_on_primary" format="color" />
    <attr name="c_primary_pressed" format="color" />
    <attr name="c_font_medium" format="reference|string" />
    <attr name="c_font_light" format="reference|string" />
    <attr name="c_font_regular" format="reference|string" />
    <!-- Titres des écrans et des cartes. -->
    <attr name="c_font_title" format="reference|string" />
    <!-- Grands chiffres (heure, chrono, température) et titre de bienvenue. -->
    <attr name="c_font_display" format="reference|string" />
    <!-- Console de l'onglet Son du deck (plaque, afficheurs, curseurs, LED), aux tons de Console douce : ui/mixer/. -->
    <attr name="c_mx_plate_top" format="color" />
    <attr name="c_mx_plate_bottom" format="color" />
    <attr name="c_mx_lcd_bg" format="color" />
    <attr name="c_mx_lcd_text" format="color" />
    <attr name="c_mx_text" format="color" />
    <attr name="c_mx_slot" format="color" />
    <attr name="c_mx_cap_top" format="color" />
    <attr name="c_mx_cap_bottom" format="color" />
    <attr name="c_mx_cap_line" format="color" />
    <attr name="c_mx_led_off" format="color" />
    <attr name="c_mx_led_low" format="color" />
    <attr name="c_mx_led_mid" format="color" />
    <attr name="c_mx_led_high" format="color" />
    <attr name="c_mx_engrave" format="color" />
    <attr name="c_mx_shadow" format="color" />
    <attr name="c_mx_highlight" format="color" />
    <attr name="c_mx_key_top" format="color" />
    <attr name="c_mx_key_bottom" format="color" />
</resources>
