<?xml version="1.0" encoding="utf-8"?>
<!-- Parler, en tête de la barre fixe : bouton plein, l'action principale ; c_talk au repos, c_talk_live pendant l'écoute (VoiceControl : isSelected). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true"><shape android:shape="rectangle"><solid android:color="?attr/c_talk_live" /><corners android:radius="18dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="?attr/c_talk" /><corners android:radius="18dp" /></shape></item>
</selector>
