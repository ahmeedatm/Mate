<?xml version="1.0" encoding="utf-8"?>
<!-- Micro d'une session au repos : rond doux de la couleur d'accent (seule action de la carte, sans crier quand plusieurs cartes en ont un). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="oval"><solid android:color="?attr/c_surface_pressed" /></shape></item>
    <item><shape android:shape="oval"><solid android:color="?attr/c_accent_soft" /></shape></item>
</selector>
