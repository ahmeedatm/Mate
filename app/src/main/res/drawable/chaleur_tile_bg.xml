<?xml version="1.0" encoding="utf-8"?>
<!-- Tuile Chaleur : aplat blanc et filet crème de 1 dp, rayon 16, sans ombre ; appui = ton crème plus soutenu. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="?attr/c_surface_pressed" /><stroke android:width="1dp" android:color="?attr/c_stroke" /><corners android:radius="16dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="?attr/c_surface" /><stroke android:width="1dp" android:color="?attr/c_stroke" /><corners android:radius="16dp" /></shape></item>
</selector>
