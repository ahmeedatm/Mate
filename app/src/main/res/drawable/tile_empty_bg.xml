<?xml version="1.0" encoding="utf-8"?>
<!-- Emplacement libre de la page Perso : contour en pointillés. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="?attr/c_surface_pressed" /><corners android:radius="20dp" /><stroke android:width="2dp" android:color="?attr/c_accent" android:dashWidth="8dp" android:dashGap="6dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="@android:color/transparent" /><corners android:radius="20dp" /><stroke android:width="2dp" android:color="?attr/c_stroke" android:dashWidth="8dp" android:dashGap="6dp" /></shape></item>
</selector>
