<?xml version="1.0" encoding="utf-8"?>
<!-- Tuile du thème Tableau : la tuile Cadran avec un filet de 1 dp (c_stroke), comme une cellule de tableau de bord. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="?attr/c_surface_pressed" /><stroke android:width="1dp" android:color="?attr/c_stroke" /><corners android:radius="32dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="?attr/c_surface" /><stroke android:width="1dp" android:color="?attr/c_stroke" /><corners android:radius="32dp" /></shape></item>
</selector>
