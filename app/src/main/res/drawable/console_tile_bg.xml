<?xml version="1.0" encoding="utf-8"?>
<!-- Tuile Console douce : aplat sans filet ni ombre, rayon 28 ; appui = c_surface_pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="?attr/c_surface_pressed" /><corners android:radius="28dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="?attr/c_surface" /><corners android:radius="28dp" /></shape></item>
</selector>
