<?xml version="1.0" encoding="utf-8"?>
<!-- Option d'une question de Claude : choisie, appuyée ou au repos. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true"><shape android:shape="rectangle"><solid android:color="?attr/c_accent_soft" /><corners android:radius="14dp" /><stroke android:width="2dp" android:color="?attr/c_accent" /></shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="?attr/c_surface_pressed" /><corners android:radius="14dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="?attr/c_surface_raised" /><corners android:radius="14dp" /></shape></item>
</selector>
