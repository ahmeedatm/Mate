<?xml version="1.0" encoding="utf-8"?>
<!-- Pastille de couleur de l'éditeur de touche (teinte appliquée dans le code) ; anneau quand sélectionnée. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true"><shape android:shape="oval"><solid android:color="?attr/c_surface" /><stroke android:width="3dp" android:color="?attr/c_accent" /></shape></item>
    <item><shape android:shape="oval"><solid android:color="?attr/c_surface" /><stroke android:width="1dp" android:color="?attr/c_stroke" /></shape></item>
</selector>
