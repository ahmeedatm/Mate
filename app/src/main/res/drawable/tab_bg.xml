<?xml version="1.0" encoding="utf-8"?>
<!-- Onglet du Deck : fond et pastille de sélection dessinés par TabStrip (la pastille glisse) ; ici, l'appui seulement. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><inset android:insetTop="2dp" android:insetBottom="2dp"><shape android:shape="rectangle"><solid android:color="?attr/c_surface_pressed" /><corners android:radius="22dp" /><stroke android:width="1dp" android:color="?attr/c_accent" /></shape></inset></item>
    <item android:drawable="@android:color/transparent" />
</selector>
