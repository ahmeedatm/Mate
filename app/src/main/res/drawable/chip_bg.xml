<?xml version="1.0" encoding="utf-8"?>
<!-- Dessiné 2 dp en retrait en haut et en bas : 44 dp visibles dans une pastille de 48 dp (cible tactile). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><inset android:insetTop="2dp" android:insetBottom="2dp"><shape android:shape="rectangle"><solid android:color="?attr/c_surface_pressed" /><corners android:radius="22dp" /><stroke android:width="1dp" android:color="?attr/c_accent" /></shape></inset></item>
    <item android:state_selected="true"><inset android:insetTop="2dp" android:insetBottom="2dp"><shape android:shape="rectangle"><solid android:color="?attr/c_accent_soft" /><corners android:radius="22dp" /><stroke android:width="1dp" android:color="?attr/c_accent" /></shape></inset></item>
    <item><inset android:insetTop="2dp" android:insetBottom="2dp"><shape android:shape="rectangle"><solid android:color="?attr/c_surface_raised" /><corners android:radius="22dp" /></shape></inset></item>
</selector>
