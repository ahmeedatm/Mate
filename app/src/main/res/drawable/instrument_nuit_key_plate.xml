<?xml version="1.0" encoding="utf-8"?>
<!-- Plaque de touche d'Instrument nuit (Touches, Applis) : une seule couche, fond noir et filet gris de 1 dp ; appui = ton enfoncé. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="?attr/c_surface_pressed" /><stroke android:width="1dp" android:color="?attr/c_stroke" /><corners android:radius="100dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="?attr/c_surface_raised" /><stroke android:width="1dp" android:color="?attr/c_stroke" /><corners android:radius="100dp" /></shape></item>
</selector>
