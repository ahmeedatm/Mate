<?xml version="1.0" encoding="utf-8"?>
<!-- Pastille de lecture en cours (en haut à droite) : fond de carte, filet fin, pilule ; plus sombre sous le doigt (elle
     ouvre l'îlot du lecteur). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/c_surface_pressed" />
            <stroke android:width="1dp" android:color="?attr/c_stroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/c_surface" />
            <stroke android:width="1dp" android:color="?attr/c_stroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
