<?xml version="1.0" encoding="utf-8"?>
<!-- Tuile du thème Contraste élevé : la tuile Cadran avec un filet de 2 dp (c_stroke, plus de 3:1 sur le fond), pour que
     chaque limite se voie sans dépendre du ton. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="?attr/c_surface_pressed" /><stroke android:width="2dp" android:color="?attr/c_stroke" /><corners android:radius="32dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="?attr/c_surface" /><stroke android:width="2dp" android:color="?attr/c_stroke" /><corners android:radius="32dp" /></shape></item>
</selector>
