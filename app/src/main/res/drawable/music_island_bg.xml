<?xml version="1.0" encoding="utf-8"?>
<!-- Îlot du lecteur ouvert (MusicIsland) : même fond et même filet que la pastille, coins plus ronds. Posé sur le fond
     de l'écran (opaque partout) : dans les thèmes à surfaces vitrées (Hush, Spider-Man), rien ne se voit au travers. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/c_bg" />
            <corners android:radius="@dimen/music_island_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/c_surface" />
            <stroke android:width="1dp" android:color="?attr/c_stroke" />
            <corners android:radius="@dimen/music_island_radius" />
        </shape>
    </item>
</layer-list>
